        {
          "name": "create_new_record_in_incident_table_with_request_body_using_data_variable",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {\r",
                  "    pm.response.to.have.status(201);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Status code name has Created\", function () {\r",
                  "    pm.response.to.have.status(\"Created\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validate response format in JSON\", function () {\r",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).contains(\"json\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validate short_description key value\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.result.short_description).to.eql(pm.iterationData.get('shortDescription'));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validate description key value\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.result.description).to.eql(pm.iterationData.get('description'));\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Validate category key value\", function () {\r",
                  "    var jsonData = pm.response.json();\r",
                  "    pm.expect(jsonData.result.category).to.eql(pm.iterationData.get('category'));\r",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "password",
                  "value": "/eESj0uC3k+O",
                  "type": "string"
                },
                {
                  "key": "username",
                  "value": "admin",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
