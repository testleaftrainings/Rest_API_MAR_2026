    {
      "name": "update-existing-record",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {\r",
              "    pm.response.to.have.status(200);\r",
              "});\r",
              "\r",
              "pm.test(\"Status code name has OK\", function () {\r",
              "    pm.response.to.have.status(\"OK\");\r",
              "});\r",
              "\r",
              "pm.test(\"Validate response format in JSON\", function () {\r",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).contains(\"json\");\r",
              "});\r",
              "\r",
              "pm.test(\"Validate short_description key value\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.result.short_description).to.eql('UpdateRecord');\r",
              "});\r",
              "\r",
              "pm.test(\"Validate description key value\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    pm.expect(jsonData.result.description).to.eql('Update record using put method');\r",
              "});\r",
              "\r",
              "pm.test(\"Validate category key value\", function () {\r",
              "    var jsonData = pm.response.json();\r",
              "    var categoryValue = jsonData.result.category;    \r",
              "    pm.expect(categoryValue.toLowerCase()).to.eql('hardware');\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
